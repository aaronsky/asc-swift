common --enable_bzlmod

common --enable_platform_specific_config
common --incompatible_strict_action_env
common --incompatible_default_to_explicit_init_py
common --incompatible_disallow_empty_glob
common --incompatible_disable_starlark_host_transitions

common:linux --repo_env=CC=clang

common:cache --bes_backend=grpcs://remote.buildbuddy.io
common:cache --bes_results_url=https://app.buildbuddy.io/invocation/
common:cache --bes_upload_mode=nowait_for_upload_complete
common:cache --remote_cache=grpcs://remote.buildbuddy.io
common:cache --remote_cache_compression
common:cache --remote_download_toplevel

try-import %workspace%/user.bazelrc
